{
  "name": "@bazak/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && concurrently --kill-others -n compiler,server \"tsc --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.tools.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@bazak/contracts": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.6"
  }
}

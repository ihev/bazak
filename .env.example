# Copy this file to .env at the workspace root.
# Relative database paths are resolved from the workspace root.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=.data/bazak.sqlite
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIRECTORY=.data/logs

# Keep credentials server-side. Never use a VITE_ prefix for secrets.
LLM_PROVIDER=gemini
# Provider request timeout (100–60000 ms). Paid requests are not automatically retried.
LLM_TIMEOUT_MS=60000
GEMINI_API_KEY=
# Set the exact model ID enabled for your Gemini key.
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

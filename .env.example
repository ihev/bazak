# Copy this file to .env at the workspace root.
# Relative database paths are resolved from the workspace root.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=.data/bazak.sqlite

# LLM integration is introduced in stage 3. No key is needed for stage 2.
# Keep credentials server-side. Never use a VITE_ prefix for secrets.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
